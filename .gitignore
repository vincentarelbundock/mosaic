.build/
__pycache__/
*.pyc
# uv provisions this from pyproject.toml for the repo's Python tooling; it is
# generated and machine-specific. pyproject.toml and uv.lock are committed.
.venv/
.claude/settings.local.json
.hermes/
docs-src/examples/decks/*/.calepin/
# Calepin writes these per-page wrappers next to the page it is rendering and
# does not always clean them up. They are scratch, never source.
.calepin-entry.*
# docs/ is the rendered site: build output only, and Calepin wipes and rewrites
# the whole directory on every build. It stays out of the index by default so an
# ordinary commit never carries a rebuild; publishing to GitHub Pages is the
# deliberate act of force-adding it. See CLAUDE.md for the command.
docs/
trash/
dist/
# Syncthing scratch files
.syncthing.*.tmp
*.sync-conflict-*
*.tmp.[0-9]*.*
uv.lock
